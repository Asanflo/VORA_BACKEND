# ===============================================
# VORA Backend Configuration (FastAPI + SQLModel)
# ===============================================

# Environnement: development | production | test
ENVIRONMENT=development
PROJECT_NAME="VORA Mobility Backend"
DEBUG=True

# -----------------------------------------------
# Base de Données (SupaBase / PostgreSQL / SQLite)
# -----------------------------------------------
# Pour SupaBase PostgreSQL, utilisez le format asyncpg:
# DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# En local ou test rapide sans réseau, SQLite async est utilisé par défaut:
DATABASE_URL="sqlite+aiosqlite:///./vora.db"

# SupaBase Credentials (optionnel pour stockage fichiers S3/Supabase Storage)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-or-service-key"
SUPABASE_STORAGE_BUCKET="driver-documents"

# -----------------------------------------------
# Sécurité & JWT
# -----------------------------------------------
SECRET_KEY="vora_super_secret_jwt_key_cameroon_taxi_hackathon_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 jours pour faciliter le dev mobile Flutter

# -----------------------------------------------
# Agrégateur Paiement Séquestre (Mobile Money)
# Mode Sandbox / Mock par défaut
# -----------------------------------------------
PAYMENT_AGGREGATOR_MODE="mock"  # "mock" | "campay" | "notchpay" | "cinetpay"
PAYMENT_AGGREGATOR_API_KEY="sandbox_key"
PAYMENT_AGGREGATOR_API_SECRET="sandbox_secret"
VORA_COMMISSION_PERCENTAGE=10.0  # 10% de commission prélevée sur courses cash/momo

# -----------------------------------------------
# IA Vocale (Google Gemini API)
# -----------------------------------------------
# Clé Gemini pour le traitement du langage naturel (Français familier & Pidgin)
# En cas d'absence de clé, le moteur local de secours (regex + dictionnaires) prend le relais automatiquement.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# -----------------------------------------------
# CORS & WebSockets
# -----------------------------------------------
ALLOWED_ORIGINS=["*"]
